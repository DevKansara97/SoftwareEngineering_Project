# ── Seva Connect - Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in YOUR values:
#   cp .env.example .env
#
# NEVER commit .env to Git!
# ──────────────────────────────────────────────────────────────────────────────

# Flask
SECRET_KEY=seva_connect_secret_key_2024

# Oracle DB (change to YOUR Oracle user/password)
DB_USER=C##YourUsername
DB_PASSWORD=YourPassword
DB_DSN=localhost:1521/XE

# SMTP - Gmail App Password for 2FA OTP emails
# To generate an app password: Google Account → Security → 2-Step Verification → App Passwords
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Google OAuth (optional - for Google Sign-In)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# GOOGLE_MAPS_API_KEY=
